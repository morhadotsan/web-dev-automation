<!-- Lazy-load script: swap data-src → src after page load for all .lzImg2 elements. -->
<script>
window.addEventListener("load", function(){
    setTimeout(function(){
        $(".lzImg2").each(function(){
            let lazyImgSrc2 = $(this).data("src");
            $(this).attr("src", lazyImgSrc2);
        });
    }, 150);
});
</script>
