# === SITEMAPS ===
# List the RSS feed, the root static sitemap, and every sitemaps/*.xml entry.
# sitemaps/*.htaccess rewrites .xml URLs to .php files, so use .xml extensions here.
# Include one Sitemap line per sitemap file in the sitemaps/ folder.
Sitemap: {{PROD_URL}}feed/rss
Sitemap: {{PROD_URL}}sitemap.xml
Sitemap: {{PROD_URL}}sitemaps/authors.xml
Sitemap: {{PROD_URL}}sitemaps/blog-1.xml
Sitemap: {{PROD_URL}}sitemaps/blog-2.xml
# Add one Sitemap: line per per-category sitemap (one per main_category from features.yaml):
# Sitemap: {{PROD_URL}}sitemaps/<category>.xml
Sitemap: {{PROD_URL}}sitemaps/category.xml
