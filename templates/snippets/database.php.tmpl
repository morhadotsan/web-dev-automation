// ---- Helpers tied to the connection ---------------------------------------
function extractCleanUrl(string $url): string {
    $parsed = parse_url($url);
    $host = $parsed["host"] ?? "";
    $path = $parsed["path"] ?? "/";
    return "https://".$host.$path;
}
