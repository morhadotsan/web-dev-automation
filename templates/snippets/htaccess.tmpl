<IfModule mod_rewrite.c>

RewriteEngine On
# Toggle the two rules below for production (www-redirect + HTTPS enforcement).
#RewriteCond %{HTTP_HOST} !^www\.(.*)$ [NC]
#RewriteRule ^(.*)$ https://www.{{DOMAIN}}/$1 [L,R=301]

#RewriteCond %{HTTPS} off
#RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block uncommon HTTP methods (PUT, DELETE, etc.)
RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD)
RewriteRule .* - [R=405,L]

# Strip trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

Header set X-XSS-Protection "1; mode=block"
Header always set X-Frame-Options "SAMEORIGIN"
Header set X-Content-Type-Options nosniff
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
Header set Referrer-Policy "same-origin"
Header set Feature-Policy "geolocation 'self'; vibrate 'none'"

# Disable directory browsing (complements index.php redirect stubs in every subfolder)
Options All -Indexes

# Block direct HTTP access to this file
<Files .htaccess>
Order allow,deny
Deny from all
</Files>

# ---- Page rewrites -----------------------------------------------------------
# Replace {{PAGE_REWRITES}} with one RewriteRule per clean URL derived from
# page_map.json. Use the patterns below as a guide — choose the right one
# for each page's "after" target.
#
# Static slug (no params):
#   RewriteRule ^slug-name$  target.php [NC,L]
#
# Dynamic slug with one capture (e.g. category, author):
#   RewriteRule ^prefix-([^/]+)$  target.php?param=$1 [QSA,L]
#
# Paginated dynamic slug (e.g. category with page number):
#   RewriteRule ^prefix-([a-z0-9-/]+)-page-(.+)?$  target.php?param=$1&page=$2 [L,QSA]
#
# NOTE: real subdirectory paths (e.g. /blogs_on/slug, /feed/rss) are resolved
# by Apache as physical files — they do NOT need a RewriteRule here.
{{PAGE_REWRITES}}

ErrorDocument 400 /404-page
ErrorDocument 401 /404-page
ErrorDocument 403 /404-page
ErrorDocument 404 /404-page
ErrorDocument 500 /404-page

</IfModule>
